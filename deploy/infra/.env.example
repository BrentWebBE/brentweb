# Copy to /srv/infra/.env (chmod 600). Root account for administration only;
# every site gets its own user with readWrite on its own database.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_32
# WiredTiger cache in GB (default 1). Keep it well below the server's RAM.
MONGO_CACHE_GB=1
