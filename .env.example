# ── Database ──────────────────────────────────────────────────
# Local: docker compose -f docker/compose.dev.yml up -d
DATABASE_URI=mongodb://127.0.0.1:27017/brentweb?replicaSet=rs0

# ── Payload ───────────────────────────────────────────────────
# Used to encrypt JWT tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of the site. Used for CORS, links, sitemaps and JSON-LD. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Validates live preview / draft requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Authenticates cron calls to the jobs endpoint (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# ── Feature flags (default: false) ────────────────────────────
# Read at runtime; a restart applies changes (no rebuild).
FEATURE_BLOG=false
FEATURE_MENU=false
FEATURE_ECOMMERCE=false

# ── Webshop / Stripe (only needed when FEATURE_ECOMMERCE=true) ─
# Test keys (sk_test_/pk_test_) locally, live keys in production. All read at runtime.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint https://<domain>/api/payments/stripe/webhooks
# (locally: printed by `stripe listen`)
STRIPE_WEBHOOKS_SIGNING_SECRET=

# ── E-mail from Payload (password resets, invites, form notifications) ──
# Sent through Resend when RESEND_API_KEY (below) is set; the sender must be on a domain
# verified in Resend. Without a key, SMTP_HOST is used; with neither, mails are only logged.
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Website
# Only for a classic mail host (not Microsoft 365: it no longer allows SMTP basic auth).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Leads (contact form, estimator, website check) ────────────
# All optional in dev. RESEND_API_KEY also sends Payload's mail (above).
# Without it lead emails are logged instead of sent
# (in production that counts as a failed delivery unless the CRM webhook took it).
RESEND_API_KEY=
# Sender (verified Resend domain) and where lead notifications go.
LEAD_FROM_EMAIL=BrentWeb Leads <leads@brentweb.eu>
LEAD_NOTIFICATION_EMAIL=brent@brentweb.be
# n8n CRM hub (internal Docker URL, e.g. http://n8n:5678/webhook/website-inquiry).
# Empty: leads are not forwarded. The secret goes out as X-Webhook-Secret.
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ── Estimator AI analysis ─────────────────────────────────────
# Empty: the estimator hides its AI step. ANTHROPIC_MODEL defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Signs the AI analysis the browser carries back. Falls back to ANTHROPIC_API_KEY.
ESTIMATE_SIGNING_SECRET=

# ── Analytics & maps (read on the server, passed to the browser) ─
# Umami website id (analytics.brentweb.be). Empty: no tracker.
UMAMI_WEBSITE_ID=
# Google Maps JavaScript API key. Empty: the contact map uses OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# ── Live project screenshots ──────────────────────────────────
# Path to Chrome/Chromium. The Docker image sets it (/usr/bin/chromium-browser);
# locally point it at Google Chrome. Empty switches the screenshot job off.
CHROME_PATH=
