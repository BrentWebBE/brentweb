# ── Database ──────────────────────────────────────────────────
# Local: docker compose -f docker/compose.dev.yml up -d
DATABASE_URI=mongodb://127.0.0.1:27017/brentweb?replicaSet=rs0

# ── Payload ───────────────────────────────────────────────────
# Used to encrypt JWT tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of the site. Used for CORS, links, sitemaps and JSON-LD. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Validates live preview / draft requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Authenticates cron calls to the jobs endpoint (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# ── Feature flags (default: false) ────────────────────────────
# Read at runtime; a restart applies changes (no rebuild).
FEATURE_BLOG=false
FEATURE_MENU=false
FEATURE_ECOMMERCE=false

# ── Webshop / Stripe (only needed when FEATURE_ECOMMERCE=true) ─
# Test keys (sk_test_/pk_test_) locally, live keys in production. All read at runtime.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint https://<domain>/api/payments/stripe/webhooks
# (locally: printed by `stripe listen`)
STRIPE_WEBHOOKS_SIGNING_SECRET=

# ── E-mail (form notifications) ───────────────────────────────
# Leave SMTP_HOST empty in dev: e-mails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Website
